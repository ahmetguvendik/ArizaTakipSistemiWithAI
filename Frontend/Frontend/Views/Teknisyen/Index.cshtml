@model List<DTO.FaultReportDtos.GetFaultReportByDepartmanIdDto>
@{
    Layout = "~/Views/_TeknisyenLayout/Index.cshtml";   
}

<div class="container-fluid px-4">

    <div class="d-sm-flex align-items-center justify-content-between mb-4 mt-2">
        <h1 class="h3 text-dark">Arızalar</h1>
        <a href="http://testapi.solfix.help:5164/api/FaultReport/export-to-excel-departmant/@(ViewBag.DepartmentId)" class="btn btn-success shadow-sm">
            <i class="fas fa-file-excel fa-sm text-white-50"></i> Excel'e Aktar
        </a>
    </div>

    <!-- Tablo Direkt -->
    <div class="table-responsive">
        <table class="table table-bordered bg-white" id="dataTable" width="100%" cellspacing="0">
            <thead class="thead-light">
                <tr>
                    <th>İsim</th>
                    <th>Email</th>
                    <th>Başlık</th>
                    <th>Açıklama</th>
                    <th>Tarih</th>
                    <th>Departman</th>
                    <th>Durum</th>
                    <th>Detay</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ReporterName</td>
                        <td>@item.ReporterEmail</td>
                        <td>@item.Title</td>
                        <td>@item.Description</td>
                        <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@item.DepartmanName</td>
                        <td>
                            @if (item.Status == "Kapandı")
                            {
                                <span class="badge badge-danger">@item.Status</span>
                            }
                            else
                            {
                                <span class="badge badge-warning">@item.Status</span>
                            }
                        </td>
                        <td>
                            <a href="/Teknisyen/ArizaDetay/@item.Id" class="btn btn-sm btn-primary">Detay</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
