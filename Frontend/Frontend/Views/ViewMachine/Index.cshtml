@model List<DTO.MachuneDTOs.GetAllMachineByDepartmanIdDto>

@{
    Layout = "~/Views/_TeknisyenLayout/Index.cshtml";   
}
<!DOCTYPE html>
<html lang="en">

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">
        
        <!-- End of Sidebar -->

        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">

                <!-- Topbar -->
  
                <!-- End of Topbar -->

                <!-- Begin Page Content -->
                <div class="container-fluid">

                    <a href="http://localhost:5164/api/Machine/export-to-excel-department/@(ViewBag.DepartmentId)" class="btn btn-success mb-3">
                        <i class="fas fa-file-excel"></i> Excel'e Aktar
                    </a>
                    <!-- DataTales Example -->
                    <div class="card shadow mb-4">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                                    <thead>
                                    <tr>
                                        <th>Makine Adi</th>
                                        <th>Makine Seri Numarasi</th>
                                    </tr>
                                    </thead>
                                    <tfoot>
                                    <tr>
                                        <th>Makine Adi</th>
                                        <th>Makine Seri Numarasi</th>
                                    </tr>
                                    </tfoot>
                                    <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.Name</td>
                                            <td>@item.SeriNo</td>
                                        </tr>
                                    }
                                    
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
                <!-- /.container-fluid -->

            </div>
            <!-- End of Main Content -->

            <!-- Footer -->
            <!-- End of Footer -->

        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->
    <!-- Scroll to Top Button-->

</body>

</html>


