@model List<DTO.MachuneDTOs.GetAllMachineByDepartmanIdDto>

@{
    Layout = "~/Views/_TeknisyenLayout/Index.cshtml";   
}

<!-- Sayfa Başlığı ve Excel'e Aktar Butonu -->
<div class="container-fluid px-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4 mt-2">
        <h1 class="h3 text-gray-800">Makineler</h1>
        <a href="http://testapi.solfix.help:5164/api/Machine/export-to-excel-department/@(ViewBag.DepartmentId)" class="btn btn-success shadow-sm">
            <i class="fas fa-file-excel fa-sm text-white-50"></i> Excel'e Aktar
        </a>
    </div>

    <!-- Makine Tablosu -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Makine Listesi</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead class="thead-light">
                    <tr>
                        <th>Makine Adı</th>
                        <th>Makine Seri Numarası</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.SeriNo</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                    <tr>
                        <th>Makine Adı</th>
                        <th>Makine Seri Numarası</th>
                    </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>