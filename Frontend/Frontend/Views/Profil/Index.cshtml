@using System.Security.Claims
@model DTO.AppUserDto.GetUserByIdDto

@{
    Layout = User.FindFirstValue(ClaimTypes.Role)?.Contains("Teknisyen") == true
        ? "~/Views/_TeknisyenLayout/Index.cshtml"
        : "~/Views/_SupervisorLayout/Index.cshtml";
}

    <style>
        body {
            background-color: #f8f9fc;
        }

        .profile-container {
            max-width: 600px;
            margin: 60px auto;
        }

        .card {
            border-radius: 12px;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
            padding: 30px;
            background-color: #fff;
        }

        .text-primary {
            color: #4e73df !important;
        }

        .form-group label {
            font-weight: 600;
        }

        .form-control[readonly] {
            background-color: #f1f3f9;
            color: #495057;
        }

        .btn-outline-primary {
            border-color: #4e73df;
            color: #4e73df;
        }

        .btn-outline-primary:hover {
            background-color: #4e73df;
            color: white;
        }
    </style>


<div class="container profile-container">
    <div class="card">
        <div class="text-center mb-4">
            <h3 class="text-primary font-weight-bold">
                <i class="fas fa-user mr-2"></i>Kullanıcı Profili
            </h3>
            <p class="text-muted">Kullanıcı bilgileri görüntülenmektedir.</p>
        </div>

        <div class="form-group">
            <label>Ad Soyad</label>
            <input type="text" class="form-control" value="@Model.NameSurname" readonly />
        </div>

        <div class="form-group">
            <label>E-posta</label>
            <input type="email" class="form-control" value="@Model.Email" readonly />
        </div>

        <div class="form-group">
            <label>Kullanıcı Adı</label>
            <input type="text" class="form-control" value="@Model.Username" readonly />
        </div>

        <div class="form-group">
            <label>Departman</label>
            <input type="text" class="form-control" value="@Model.DepartmentName" readonly />
        </div>

        <div class="text-center mt-4">
            <a href="/Login/ResetPasswordEmail" class="btn btn-outline-primary">
                <i class="fas fa-key mr-1"></i> Şifre Değiştir
            </a>
        </div>
    </div>
</div>
