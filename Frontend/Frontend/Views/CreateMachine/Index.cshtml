@model DTO.MachuneDTOs.CreateMachineDto

@using Newtonsoft.Json

@{
Layout = null;
var successMessage = TempData["SuccessMessage"] as string;
var errorMessages = TempData["ErrorMessages"] != null
? JsonConvert.DeserializeObject<List<string>>(TempData["ErrorMessages"]?.ToString())
: null;
}

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>Makine Ekle</title>

    <!-- Stil dosyaları -->
    <link href="startbootstrap-sb-admin-2-gh-pages/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,300,400,600,700,800,900" rel="stylesheet">
    <link href="startbootstrap-sb-admin-2-gh-pages/css/sb-admin-2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body id="page-top">
<div id="wrapper">
    <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar" style="padding-top: 1rem;">
        <a class="sidebar-brand d-flex align-items-center justify-content-start px-3 mb-3" href="/Supervisor">
            <img src="/images/logo.png" alt="Logo" style="height: 48px; margin-right: 14px; display: block;" />
            <span class="h6 font-weight-bold text-white m-0">Solvix Arıza Sistemi</span>
        </a>
        <hr class="sidebar-divider my-1" />
        <li class="nav-item mb-2">
            <a class="nav-link" href="/Teknisyen">
                <i class="fas fa-fw fa-tools"></i>
                <span>Arızalar</span>
            </a>
        </li>
        <li class="nav-item mb-2">
            <a class="nav-link" href="/ViewMachine">
                <i class="fas fa-fw fa-cogs"></i>
                <span>Makine Görüntüle</span>
            </a>
        </li>
        <li class="nav-item mb-2">
            <a class="nav-link" href="/CreateMachine">
                <i class="fas fa-fw fa-plus-circle"></i>
                <span>Makine Ekle</span>
            </a>
        </li>
    </ul>

    <div id="content-wrapper" class="d-flex flex-column">
        <div id="content">
            <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                <form class="form-inline">
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>
                </form>
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item dropdown no-arrow">
                        <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown">
                            <span class="mr-2 d-none d-lg-inline text-gray-600 small">Teknisyen</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="container-fluid">
                <h1 class="h3 mb-4 text-gray-800">Makine Ekle</h1>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="card shadow mb-4">
                            <div class="card-body">
                                <form asp-action="Index" asp-controller="CreateMachine" method="post">
                                    <div class="form-group">
                                        <label asp-for="Name">Makine Adı</label>
                                        <input type="text" class="form-control" placeholder="Makine adını girin" asp-for="Name" required>
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="SerialNumber">Seri Numarası</label>
                                        <input type="text" class="form-control" placeholder="Seri numarasını girin" asp-for="SerialNumber" required>
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="DepartmentId">Departman</label>
                                        @Html.DropDownListFor(model => model.DepartmentId, (List<SelectListItem>)ViewBag.Department, "Departman Seçiniz", new { @class = "form-control" })
                                    </div>

                                    <button type="submit" class="btn btn-success btn-block font-weight-bold">
                                        <i class="fas fa-plus-circle mr-2"></i>Makineyi Ekle
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <footer class="sticky-footer bg-white">
            <div class="container my-auto">
                <div class="copyright text-center my-auto">
                    <span>Copyright &copy; Your Website 2020</span>
                </div>
            </div>
        </footer>
    </div>
</div>

<a class="scroll-to-top rounded" href="#page-top">
    <i class="fas fa-angle-up"></i>
</a>

<!-- SweetAlert -->
@if (!string.IsNullOrEmpty(successMessage))
{
<script>
    Swal.fire({
        icon: 'success',
        title: 'Başarılı!',
        text: '@successMessage',
        confirmButtonColor: '#3085d6',
        confirmButtonText: 'Tamam'
    });
</script>
}
else if (errorMessages != null && errorMessages.Count > 0)
{
<script>
    Swal.fire({
        icon: 'error',
        title: 'Hata!',
        html: '@Html.Raw(string.Join("<br/>", errorMessages))',
        confirmButtonColor: '#d33',
        confirmButtonText: 'Tamam'
    });
</script>
}

<!-- JS dosyaları -->
<script src="startbootstrap-sb-admin-2-gh-pages/vendor/jquery/jquery.min.js"></script>
<script src="startbootstrap-sb-admin-2-gh-pages/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="startbootstrap-sb-admin-2-gh-pages/vendor/jquery-easing/jquery.easing.min.js"></script>
<script src="startbootstrap-sb-admin-2-gh-pages/js/sb-admin-2.min.js"></script>
</body>

</html>