@model List<DTO.FaultReportDtos.GetFaultReportDto>

@{
    Layout = "~/Views/_SupervisorLayout/Index.cshtml";   
}
<!DOCTYPE html>
<html lang="en">

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">
        
        <!-- End of Sidebar -->

        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">

                <!-- Topbar -->
  
                <!-- End of Topbar -->

                <!-- Begin Page Content -->
                <div class="container-fluid">

                   <h1 class="h3 mb-2 text-gray-800">Arızalar</h1>
                <a href="http://localhost:5164/api/FaultReport/export-to-excel" class="btn btn-success mb-3">
                    <i class="fas fa-file-excel"></i> Excel'e Aktar
                </a>
                <div class="card shadow mb-4">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th>İsim</th>
                                        <th>Email</th>
                                        <th>Başlık</th>
                                        <th>Açıklama</th>
                                        <th>Tarih</th>
                                        <th>Departman</th>
                                        <th>Durum</th>
                                        <th>Detay</th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th>İsim</th>
                                        <th>Email</th>
                                        <th>Başlık</th>
                                        <th>Açıklama</th>
                                        <th>Tarih</th>
                                        <th>Departman</th>
                                        <th>Durum</th>
                                        <th>Detay</th>
                                    </tr>
                                </tfoot>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.ReporterName</td>
                                            <td>@item.ReporterEmail</td>
                                            <td>@item.Title</td>
                                            <td>@item.Description</td>
                                            <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>@item.DepartmanName</td>
                                            <td>@item.Status</td>
                                            <td><a href="/Supervisor/ArizaDetay/@item.Id">Detay</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>


                </div>
                <!-- /.container-fluid -->

            </div>
            <!-- End of Main Content -->

            <!-- Footer -->
            <!-- End of Footer -->

        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->
    <!-- Scroll to Top Button-->

</body>

</html>